{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./server/node_modules/**)",
      "Read(./.git/**)",
      "Read(./vendor/ocr/**)",
      "Read(./vendor/*.min.js)",
      "Read(./private/**)",
      "Read(./tests/e2e/files/**)",
      "Read(./tests/e2e/shots/**)",
      "Read(./package-lock.json)",
      "Read(./server/package-lock.json)"
    ]
  },
  "enabledPlugins": {
    "adobe-for-creativity@anthropic-plugin-directory": false,
    "animatedwebs@anthropic-plugin-directory": false,
    "bigdata-com@anthropic-plugin-directory": false,
    "bio-research@anthropic-plugin-directory": false,
    "box@anthropic-plugin-directory": false,
    "brand-voice@anthropic-plugin-directory": false,
    "canva@anthropic-plugin-directory": false,
    "claude-for-financial-advisors@anthropic-plugin-directory": false,
    "cowork-plugin-management@anthropic-plugin-directory": false,
    "customer-support@anthropic-plugin-directory": false,
    "daloopa@anthropic-plugin-directory": false,
    "data@anthropic-plugin-directory": false,
    "datarobot-agent-skills@anthropic-plugin-directory": false,
    "desktop-commander@anthropic-plugin-directory": false,
    "enterprise-search@anthropic-plugin-directory": false,
    "finance@anthropic-plugin-directory": false,
    "human-resources@anthropic-plugin-directory": false,
    "legal@anthropic-plugin-directory": false,
    "lseg@anthropic-plugin-directory": false,
    "marketing@anthropic-plugin-directory": false,
    "operations@anthropic-plugin-directory": false,
    "product-management@anthropic-plugin-directory": false,
    "productivity@anthropic-plugin-directory": false,
    "sales@anthropic-plugin-directory": false,
    "small-business@anthropic-plugin-directory": false,
    "sp-global@anthropic-plugin-directory": false,
    "vpai@anthropic-plugin-directory": false,
    "wix@anthropic-plugin-directory": false,
    "brightdata-plugin@knowledge-work-plugins": false,
    "product-tracking-skills@knowledge-work-plugins": false,
    "searchfit-seo@knowledge-work-plugins": false,
    "slack-by-salesforce@knowledge-work-plugins": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guardrails.mjs"
          }
        ]
      }
    ]
  }
}
